{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "regions": ["iad1"],
  "functions": {
    "server.js": {
      "runtime": "nodejs18.x"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
